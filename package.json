{
  "name": "sanka-burgers",
  "version": "1.0.0",
  "description": "Sanka Burgers — Site + Clube API",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "build": "node build.mjs",
    "dev": "concurrently \"node build.mjs --watch\" \"node server.js\"",
    "db:migrate": "node scripts/migrate-database.js",
    "test": "node --test test/*.test.js test/*.test.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@vercel/blob": "^0.27.3",
    "dotenv": "^16.4.5",
    "esbuild": "^0.28.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "sharp": "^0.34.5"
  }
}
